<view class="page-shell storage-page">
  <text class="title">本地存储</text>
  <text class="subtitle">查看照片文件与记录缓存的占用。</text>

  <view class="card">
    <text class="section-title">照片文件</text>
    <text wx:if="{{loading}}" class="status-text">正在读取…</text>
    <block wx:elif="{{files.available}}">
      <view class="metric"><text>已保存文件</text><text>{{files.count}} 个</text></view>
      <view class="metric"><text>总大小</text><text>{{files.sizeLabel}}</text></view>
    </block>
    <text wx:else class="error-text" selectable="{{true}}">未能读取：{{files.error}}</text>
    <text class="helper">文件数包含原图、缩略图及替换或删除记录后留下的旧文件。当前无法读取照片文件的容量上限。</text>
  </view>

  <view class="card">
    <text class="section-title">记录与设置缓存</text>
    <text wx:if="{{loading}}" class="status-text">正在读取…</text>
    <block wx:else>
      <view wx:if="{{cache.available}}" class="metric"><text>全部缓存</text><text>{{cache.sizeLabel}} / {{cache.limitLabel}}</text></view>
      <text wx:else class="error-text" selectable="{{true}}">缓存占用未能读取：{{cache.error}}</text>
      <block wx:if="{{records.available}}">
        <view class="metric"><text>记录数量</text><text>{{records.count}} 条</text></view>
        <view class="metric"><text>记录内容（估算）</text><text>{{records.sizeLabel}}</text></view>
      </block>
      <text wx:else class="error-text" selectable="{{true}}">记录占用未能读取：{{records.error}}</text>
    </block>
    <text class="helper">此处容量独立于照片文件。全部缓存还包含菜单和设置；记录内容按文本大小估算。</text>
  </view>

  <view class="card">
    <text class="section-title">最近所选图片</text>
    <block wx:if="{{selection}}">
      <view class="metric"><text>{{selection.source}}</text><text>{{selection.sizeLabel}}</text></view>
      <text class="helper">{{selection.timeLabel}}</text>
    </block>
    <text wx:else class="status-text">更新此版本后，选择一次照片即可查看。</text>
  </view>

  <view class="card">
    <text class="section-title">最近一次失败</text>
    <block wx:if="{{failure}}">
      <text class="error-text">{{failure.reason}}</text>
      <text wx:if="{{failure.originalSaved}}" class="helper">原图已保存，列表使用原图显示。</text>
      <view class="metric"><text>失败环节</text><text>{{failure.stage}}</text></view>
      <view class="metric"><text>当时所选图片</text><text>{{failure.sizeLabel}}</text></view>
      <text class="raw-error" selectable="{{true}}">{{failure.message}}</text>
      <text wx:if="{{failure.codes}}" class="raw-error" selectable="{{true}}">{{failure.codes}}</text>
      <text class="helper">{{failure.timeLabel}}</text>
    </block>
    <text wx:else class="status-text">暂未捕获失败信息。再次添加照片失败时，会在这里保留具体原因。</text>
    <text wx:if="{{persistenceError}}" class="error-text" selectable="{{true}}">诊断信息仅在本次运行中保留，缓存写入失败：{{persistenceError}}</text>
  </view>

  <button class="secondary-button refresh-button" bindtap="refresh" loading="{{loading}}" disabled="{{loading}}">刷新占用</button>
  <button class="secondary-button copy-button" bindtap="copyReport" disabled="{{loading}}">复制诊断信息</button>
  <text wx:if="{{updatedAt}}" class="updated-at">读取于 {{updatedAt}}</text>
</view>
