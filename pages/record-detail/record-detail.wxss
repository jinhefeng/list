.detail-shell { padding-bottom: 56rpx; }
.detail-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.detail-heading-copy { flex: 1; min-width: 0; }
.detail-heading .title { overflow-wrap: anywhere; }
.more-dismiss-layer { position: fixed; z-index: 8; top: 0; right: 0; bottom: 0; left: 0; }
.more-wrap { position: relative; z-index: 10; flex: none; margin-top: 22rpx; }
.more-button { display: flex; width: 72rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 18rpx; color: #53604e; background: #e9eee5; font-size: 36rpx; line-height: 1; }
.more-menu { position: absolute; z-index: 11; top: 72rpx; right: 0; width: 176rpx; padding: 8rpx 18rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 8rpx 30rpx rgba(35,45,33,.15); }
.more-menu text { display: block; padding: 18rpx 4rpx; font-size: 24rpx; }
.more-menu .more-edit-action { color: #4f6b49; }
.more-menu .more-delete-action { border-top: 1rpx solid #eef0eb; color: #a14a3b; }
.detail-owner { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; color: #858b80; font-size: 22rpx; }
.type-pill { padding: 8rpx 16rpx; border-radius: 99rpx; color: #4f6b49; background: #e9efe5; }
.drink-photo-frame { box-sizing: border-box; width: 100%; margin: 24rpx 0 0; padding: 10rpx; overflow: hidden; border: 2rpx solid #e6eae1; border-radius: 30rpx; background: #fff; box-shadow: 0 10rpx 38rpx rgba(43,56,39,.06); }
.drink-detail-photo { display: block; width: 100%; height: auto; border-radius: 20rpx; }
.detail-photo-card { padding: 16rpx; }
.detail-photo-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.detail-photo-cell { position: relative; flex: 0 0 calc(50% - 6rpx); overflow: hidden; border-radius: 18rpx; background: #eef1e9; }
.detail-photo { display: block; width: 100%; height: 300rpx; }
.detail-photo-name { display: block; overflow: hidden; padding: 10rpx 12rpx; color: #4f574a; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.detail-card { padding: 26rpx 28rpx; }
.detail-card .section-title { margin-bottom: 8rpx; }
.detail-field { display: flex; justify-content: space-between; gap: 24rpx; padding: 20rpx 0; border-bottom: 1rpx solid #eef0eb; }
.detail-field:last-child { border-bottom: 0; }
.detail-label { flex: none; color: #81877c; font-size: 24rpx; }
.detail-value { flex: 1; min-width: 0; color: #2d382a; font-size: 25rpx; line-height: 1.5; text-align: right; overflow-wrap: anywhere; }
.meal-dishes-section { margin-top: 34rpx; }
.meal-dishes-heading { display: flex; align-items: flex-end; justify-content: space-between; padding: 0 4rpx 16rpx; }
.meal-dishes-heading-copy { display: flex; flex-direction: column; gap: 5rpx; }
.meal-dishes-eyebrow { color: #829078; font-size: 17rpx; font-weight: 700; letter-spacing: 3rpx; }
.meal-dishes-title { color: #2d382a; font-size: 32rpx; font-weight: 700; line-height: 1.25; }
.meal-dishes-count { display: flex; align-items: baseline; gap: 6rpx; padding: 8rpx 14rpx; border-radius: 99rpx; color: #5b7154; background: #eaf0e6; }
.meal-dishes-count-number { font-size: 23rpx; font-weight: 700; }
.meal-dishes-count-label { font-size: 20rpx; }
.meal-dish-list { display: flex; flex-direction: column; gap: 14rpx; }
.meal-dish-card { box-sizing: border-box; display: flex; min-height: 188rpx; align-items: center; gap: 20rpx; padding: 14rpx; border: 1rpx solid #e9ece5; border-radius: 25rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(43,56,39,.045); }
.meal-dish-photo-wrap { position: relative; box-sizing: border-box; flex: none; width: 212rpx; height: 160rpx; overflow: hidden; border-radius: 17rpx; background: #eef1e9; }
.meal-dish-photo { display: block; width: 100%; height: 100%; }
.meal-dish-photo-shade { position: absolute; right: 0; bottom: 0; left: 0; height: 72rpx; background: linear-gradient(180deg, rgba(19,27,16,0), rgba(19,27,16,.48)); }
.meal-dish-photo-number { position: absolute; bottom: 12rpx; left: 14rpx; color: #fff; font-size: 18rpx; font-weight: 700; letter-spacing: 1rpx; text-shadow: 0 1rpx 5rpx rgba(0,0,0,.3); }
.meal-dish-photo-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: #899283; background: #f1f3ee; }
.meal-dish-photo-empty .meal-dish-photo-number { color: #8d9787; text-shadow: none; }
.meal-dish-placeholder-mark { display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; border: 2rpx solid #c8d0c1; border-radius: 50%; }
.meal-dish-placeholder-mark view { width: 18rpx; height: 18rpx; border: 2rpx solid #c8d0c1; border-radius: 50%; }
.meal-dish-empty-label { font-size: 18rpx; }
.meal-dish-info { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: flex-start; justify-content: center; gap: 12rpx; padding: 8rpx 12rpx 8rpx 0; }
.meal-dish-index { color: #819078; font-size: 17rpx; font-weight: 700; letter-spacing: 2rpx; }
.meal-dish-name { color: #2e392b; font-size: 29rpx; font-weight: 650; line-height: 1.42; overflow-wrap: anywhere; }
.meal-dish-accent { width: 32rpx; height: 4rpx; margin-top: 1rpx; border-radius: 99rpx; background: #b6c7ab; }
.detail-location-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx 28rpx; }
.detail-location-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 8rpx; }
.detail-location-name { color: #2d382a; font-size: 25rpx; line-height: 1.45; overflow-wrap: anywhere; }
.detail-location-address { color: #858b80; font-size: 21rpx; line-height: 1.45; overflow-wrap: anywhere; }
.detail-location-icon { color: #5b7751; font-size: 38rpx; }
.detail-actions { margin-top: 30rpx; }
.readonly-note { padding: 26rpx 0; color: #858b80; font-size: 22rpx; text-align: center; }
.edit-heading { align-items: center; }
.cancel-edit { flex: none; padding: 14rpx 4rpx; color: #5f7b55; font-size: 25rpx; }
.generic-notes { min-height: 150rpx; }
.date-time-row { display: flex; gap: 18rpx; }
.date-time-row picker { flex: 1; min-width: 0; }
.picker-value { padding: 22rpx; border-radius: 16rpx; background: #f7f8f4; }
.generic-preserve-note { display: block; margin-top: 22rpx; color: #858b80; font-size: 21rpx; }
.save-button { margin-top: 28rpx; }
