.history-title-row { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; }
.history-title-row .title { flex: 1; margin-top: 0; }
.filter-toggle { position: relative; display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; margin-right: -10rpx; opacity: .72; }
.filter-glyph { display: flex; width: 30rpx; height: 32rpx; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 3rpx; }
.filter-glyph-top { width: 0; height: 0; border-top: 17rpx solid #7f8979; border-right: 13rpx solid transparent; border-left: 13rpx solid transparent; }
.filter-glyph-stem { width: 5rpx; height: 12rpx; margin-top: -1rpx; border-radius: 0 0 4rpx 4rpx; background: #7f8979; }
.filter-active-dot { position: absolute; top: 8rpx; right: 7rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: #5b7751; }
.filter-panel { margin-top: 20rpx; padding: 24rpx; border: 1rpx solid #edf0e9; border-radius: 22rpx; background: #fbfcf9; }
.filter-section-heading { color: #5f685a; font-size: 23rpx; font-weight: 600; }
.filter-date-row { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.filter-date-row picker { flex: 1; min-width: 0; }
.filter-date-value { overflow: hidden; padding: 18rpx 14rpx; border: 1rpx solid #e8ebe4; border-radius: 14rpx; color: #465341; background: #fff; font-size: 21rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.filter-date-empty { color: #969c92; }
.filter-date-separator { flex: none; color: #9ba197; font-size: 21rpx; }
.filter-user-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }
.filter-select-all,.filter-reset { color: #788371; font-size: 21rpx; }
.filter-user-list,.filter-type-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.filter-user-option,.filter-type-option { display: flex; align-items: center; gap: 9rpx; min-height: 56rpx; padding: 0 16rpx; border: 1rpx solid #e8ebe4; border-radius: 99rpx; color: #747d70; background: #fff; font-size: 21rpx; }
.filter-user-option.selected,.filter-type-option.selected { border-color: #cbd7c5; color: #506a47; background: #f3f6f0; }
.filter-user-check,.filter-type-check { display: flex; width: 25rpx; height: 25rpx; align-items: center; justify-content: center; border: 1rpx solid #cbd1c7; border-radius: 50%; color: #fff; font-size: 17rpx; line-height: 1; }
.filter-user-option.selected .filter-user-check,.filter-type-option.selected .filter-type-check { border-color: #68805e; background: #68805e; }
.filter-no-users,.filter-no-options { display: block; margin-top: 12rpx; color: #92988d; font-size: 21rpx; }
.filter-actions { display: flex; align-items: center; justify-content: flex-end; gap: 22rpx; margin-top: 22rpx; }
.filter-apply { min-height: 62rpx; margin: 0; padding: 12rpx 22rpx; border-radius: 99rpx; color: #fff; background: #536f4b; font-size: 22rpx; line-height: 1.4; }
.timeline-list { margin-top: 30rpx; }
.timeline-entry { display: flex; gap: 12rpx; margin-top: 24rpx; }
.timeline-entry:first-child { margin-top: 0; }
.timeline-meta { position: relative; flex: 0 0 190rpx; box-sizing: border-box; padding: 12rpx 28rpx 0 0; text-align: right; }
.timeline-meta::after { position: absolute; top: 27rpx; right: 12rpx; bottom: -51rpx; width: 2rpx; background: #dce4d6; content: ''; }
.timeline-entry.last .timeline-meta::after { display: none; }
.timeline-date,.timeline-time,.timeline-user { display: block; width: 162rpx; text-align: right; }
.timeline-date { color: #334b35; font-size: 22rpx; font-weight: 700; line-height: 1.2; }
.timeline-time { color: #7f8979; font-size: 21rpx; line-height: 1.2; }
.timeline-user { margin-top: 5rpx; color: #a0a69a; font-size: 18rpx; line-height: 1.2; }
.timeline-dot { position: absolute; z-index: 1; top: 14rpx; right: 0; box-sizing: border-box; width: 26rpx; height: 26rpx; border: 5rpx solid #f6f7f2; border-radius: 50%; background: #6a8060; }
.timeline-row { display: flex; flex: 1; align-items: center; gap: 16rpx; min-width: 0; padding: 8rpx 0 20rpx; border-bottom: 1rpx solid #e8ebe5; }
.timeline-entry.last .timeline-row { border-bottom: 0; }
.timeline-thumb { flex: none; width: 168rpx; height: 168rpx; border-radius: 18rpx; }
.placeholder { display: flex; align-items: center; justify-content: center; color: #75916c; background: #edf1e9; font-size: 27rpx; }
.timeline-info { flex: 1; min-width: 0; padding: 3rpx 0; }
.record-name { overflow: hidden; max-width: 250rpx; font-size: 26rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.record-brand,.record-details,.record-nutrition,.record-location { display: block; margin-top: 9rpx; color: #81887e; font-size: 20rpx; line-height: 1.4; }
.record-nutrition { color: #688060; }
.record-location { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.timeline-entry { position: relative; }
.meal-timeline-row { align-items: flex-start; }
.meal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.meal-kind { flex: none; padding: 7rpx 14rpx; border-radius: 99rpx; color: #4f6b49; background: #edf2e9; font-size: 19rpx; }
.meal-dish-photos { position: relative; flex: 0 0 auto; min-width: 0; }
.meal-dish-photo-cell { position: absolute; top: 0; box-sizing: border-box; width: 168rpx; height: 168rpx; overflow: hidden; border: 2rpx solid #fff; border-radius: 18rpx; background: #fff; box-shadow: 0 5rpx 12rpx rgba(35,50,35,.17); }
.meal-dish-thumb { display: block; box-sizing: border-box; width: 100%; height: 100%; border-radius: 16rpx; }
.meal-dish-photos-empty { flex: none; width: 168rpx; height: 168rpx; border-radius: 18rpx; }
.meal-dish-photo-cell .meal-photo-count { position: absolute; right: 8rpx; bottom: 8rpx; z-index: 5; padding: 5rpx 10rpx; border-radius: 99rpx; color: #fff; background: rgba(35,48,36,.8); font-size: 18rpx; line-height: 1.25; }
.meal-dish-list { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.meal-dish-name { flex: none; max-width: 100%; box-sizing: border-box; padding: 6rpx 9rpx; border-radius: 9rpx; color: #66725f; background: #f7f8f4; font-size: 19rpx; line-height: 1.35; white-space: normal; word-break: break-all; }
