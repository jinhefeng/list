<view class="page-shell tab-page-shell">
  <view class="eyebrow">A GENTLE LOOK AT YOUR DAY</view>
  <text class="title">摄入概览</text>
  <text class="subtitle">根据饮品记录汇总当日摄入。</text>
  <view class="card date-card"><text class="field-label">查看日期</text><picker mode="date" value="{{date}}" bindchange="onDateChange"><view class="picker-value">{{date}}</view></picker></view>
  <view class="nutrition-hero"><text class="nutrition-eyebrow">当日饮品</text><text class="nutrition-count">{{summary.drinkCount || 0}}<text> 杯</text></text><view class="nutrition-main"><view><text class="nutrition-value">{{summary.energyLabel || '—'}}</text><text class="nutrition-label">能量 kcal</text></view><view><text class="nutrition-value">{{summary.sugarLabel || '—'}}</text><text class="nutrition-label">糖量</text></view><view><text class="nutrition-value">{{summary.caffeineLabel || '—'}}</text><text class="nutrition-label">咖啡因</text></view></view></view>
  <view class="card" wx:if="{{hasRecords}}"><text class="section-title">本日饮品明细</text><view wx:for="{{records}}" wx:key="id" class="nutrition-row"><view><text class="nutrition-drink">{{item.drinkName}}</text><text class="nutrition-brand">{{item.brandName || '自定义饮品'}} · {{item.timeLabel}}</text></view><view class="nutrition-right"><text>{{item.nutritionAmountsLabel}}</text></view></view></view>
  <view wx:else class="empty-card"><text class="empty-title">这一天还没有饮品记录</text></view>
</view>
