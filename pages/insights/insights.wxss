.date-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.date-card .field-label { margin: 0; }
.nutrition-hero { margin-top: 24rpx; padding: 32rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(145deg,#657e56,#344b35); }
.nutrition-eyebrow,.nutrition-label { display: block; color: rgba(255,255,255,.68); font-size: 21rpx; }
.nutrition-count { display: block; margin-top: 6rpx; font-size: 54rpx; font-weight: 700; }
.nutrition-count text { font-size: 25rpx; font-weight: 400; }
.nutrition-main { display: flex; justify-content: space-between; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.2); }
.nutrition-main>view { display: flex; flex-direction: column; gap: 7rpx; }
.nutrition-value { font-size: 28rpx; font-weight: 650; }
.nutrition-row { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #eef0eb; }
.nutrition-row:last-child { border-bottom: 0; }
.nutrition-drink,.nutrition-brand,.nutrition-right { display: block; }
.nutrition-drink { font-size: 26rpx; font-weight: 600; }
.nutrition-brand,.nutrition-right { margin-top: 8rpx; color: #858b80; font-size: 21rpx; }
.nutrition-right { text-align: right; }
.nutrition-row>view:first-child { flex: 1; min-width: 0; }
.nutrition-right { flex: none; max-width: 58%; overflow-wrap: anywhere; }
