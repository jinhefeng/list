.location-picker { display: flex; align-items: center; gap: 14rpx; min-height: 86rpx; padding: 14rpx 18rpx; border: 1rpx solid #e8ebe4; border-radius: 18rpx; background: #fbfcf9; }
.location-pin { color: #5b7751; font-size: 34rpx; }
.location-picker-text { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.location-name { overflow: hidden; color: #334b35; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.location-arrow { color: #899083; font-size: 36rpx; }
.date-time-row { display: flex; gap: 18rpx; }
.date-field { flex: 1; min-width: 0; }
.picker-value { padding: 22rpx; border-radius: 16rpx; background: #f7f8f4; }
.field-hint { display: block; margin-top: 10rpx; color: #8a9085; font-size: 21rpx; line-height: 1.55; }
.section-heading { display: flex; align-items: center; justify-content: space-between; }
.section-heading .section-title { margin-bottom: 0; }
.dish-count { color: #858b80; font-size: 22rpx; }
.dish-sort-item { margin-top: 22rpx; border-radius: 20rpx; transition: opacity .15s ease, transform .15s ease; }
.dish-sort-item.dragging { opacity: .72; transform: scale(.985); }
.dish-card { display: flex; gap: 20rpx; padding: 18rpx; border-radius: 20rpx; background: #f8f9f6; }
.dish-photo-box { flex: none; width: 180rpx; height: 180rpx; }
.dish-photo,.dish-photo-empty { box-sizing: border-box; width: 180rpx; height: 180rpx; border-radius: 16rpx; }
.dish-photo-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #dce2d6; color: #63775c; font-size: 21rpx; }
.dish-photo-plus { font-size: 44rpx; }
.dish-fields { flex: 1; min-width: 0; }
.dish-fields-header { display: flex; align-items: center; justify-content: space-between; gap: 6rpx; }
.dish-fields .field-label { margin-top: 2rpx; }
.dish-drag-handle { display: flex; flex: none; align-items: center; gap: 5rpx; padding: 8rpx 9rpx; border: 1rpx solid #e3e8df; border-radius: 10rpx; color: #798373; font-size: 18rpx; }
.dish-drag-glyph { color: #607457; font-size: 24rpx; line-height: 1; }
.dish-fields .input { min-height: 76rpx; padding: 18rpx; font-size: 24rpx; }
.dish-remove { display: inline-block; margin-top: 18rpx; color: #9b5148; font-size: 21rpx; }
.add-dish { display: flex; align-items: center; justify-content: center; gap: 10rpx; min-height: 88rpx; margin-top: 20rpx; border: 1rpx dashed #cbd5c5; border-radius: 18rpx; color: #4f6b49; font-size: 24rpx; }
.add-dish-plus { font-size: 32rpx; }
.notes-input { min-height: 150rpx; }
.save-button { margin-top: 30rpx; }
.form-heading-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.form-heading-row>view { flex: 1; min-width: 0; }
.cancel-edit { flex: none; margin-top: 18rpx; padding: 12rpx 4rpx; color: #5f7b55; font-size: 25rpx; }
.delete-button { margin-top: 18rpx; padding: 22rpx; color: #9b5148; background: #f5eae7; }
