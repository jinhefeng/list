page { background: #f6f7f2; color: #20291f; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 28rpx; }
button { margin: 0; border-radius: 22rpx; font-size: 28rpx; line-height: 1.4; }
button::after { border: 0; }
.page-shell { padding: 32rpx 32rpx 150rpx; }
.muted { color: #858b80; }
.eyebrow { color: #5c7650; font-size: 22rpx; letter-spacing: 2rpx; }
.title { display: block; margin-top: 10rpx; font-size: 48rpx; font-weight: 700; letter-spacing: -1rpx; }
.subtitle { display: block; margin-top: 10rpx; color: #7e857a; font-size: 25rpx; }
.card { margin-top: 26rpx; padding: 28rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 10rpx 38rpx rgba(43, 56, 39, .045); }
.section-title { display: block; margin-bottom: 20rpx; font-size: 30rpx; font-weight: 650; }
.primary-button { padding: 25rpx 28rpx; color: #fff; background: #304d35; font-weight: 600; }
.secondary-button { padding: 21rpx 25rpx; color: #304d35; background: #e9efe5; }
.bottom-nav { position: fixed; right: 24rpx; bottom: 20rpx; left: 24rpx; display: flex; justify-content: space-around; padding: 20rpx 10rpx calc(18rpx + env(safe-area-inset-bottom)); border: 1rpx solid rgba(39, 56, 35, .06); border-radius: 28rpx; background: rgba(255,255,255,.96); box-shadow: 0 12rpx 42rpx rgba(30,40,27,.12); }
.nav-item { color: #899083; font-size: 23rpx; text-align: center; }
.nav-item.active { color: #304d35; font-weight: 700; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.pill { display: inline-flex; margin: 0 12rpx 14rpx 0; padding: 14rpx 20rpx; border-radius: 99rpx; color: #586151; background: #f1f3ed; font-size: 24rpx; }
.pill.selected { color: #fff; background: #5b7751; }
.field { margin-top: 22rpx; }
.field-label { display: block; margin-bottom: 12rpx; color: #555e51; font-size: 24rpx; font-weight: 600; }
.input { box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 22rpx 24rpx; border: 1rpx solid #e8ebe4; border-radius: 18rpx; background: #fbfcf9; font-size: 27rpx; }
.metric { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #eef0eb; }
.metric:last-child { border-bottom: 0; }
.drink-photo { width: 100%; height: 360rpx; border-radius: 22rpx; background: #eef1e9; object-fit: cover; }
.empty { padding: 52rpx 24rpx; color: #899083; text-align: center; }
